# Copy to .env to override defaults used by docker-compose.yml
API_KEY=dev-api-key
# Required when running outside docker compose (compose sets them for its containers):
# DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
# RABBIT_URL=amqp://guest:guest@localhost:5672/
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
GATEWAY_MIN_DELAY_S=2
GATEWAY_MAX_DELAY_S=5
GATEWAY_SUCCESS_RATE=0.9
LOG_LEVEL=INFO
